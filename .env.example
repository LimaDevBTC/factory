# =====================================================================
# Factory — environment variables
# Copy to .env.local for development. Never commit .env.local.
# Vars mínimas pra T1: KNOWN_ROOT_DOMAINS, NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, OPERATOR_EMAILS.
# Stripe/Satispay/Resend/R2/Anthropic etc. entram em tasks subsequentes.
# =====================================================================

# ----- Domain config ------------------------------------------------
# The root domain you bought. Use lvh.me for local dev (it resolves to 127.0.0.1).
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me
# Production: NEXT_PUBLIC_ROOT_DOMAIN=thefactory.life

# Multi-org root domains (comma-separated). Each org has its own root domain.
# v1: only Edson's. v2+: as new operators join, add their root here OR switch
# to DB-driven resolution.
KNOWN_ROOT_DOMAINS=lvh.me,thefactory.life

# ----- Supabase (region: eu-central-1 / Frankfurt) ------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Anthropic ----------------------------------------------------
ANTHROPIC_API_KEY=
# Models we use:
#   claude-opus-4-7    → menu extraction (vision)
#   claude-haiku-4-5   → copy generation, translation
ANTHROPIC_MODEL_VISION=claude-opus-4-7
ANTHROPIC_MODEL_TEXT=claude-haiku-4-5-20251001

# ----- Cloudflare R2 (storage, EU jurisdiction) ---------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=factory-media
R2_PUBLIC_URL=https://media.thefactory.life

# ----- Stripe -------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs (create in Stripe dashboard, EUR)
STRIPE_PRICE_STARTER_SETUP=price_xxx       # €20 one-time
STRIPE_PRICE_STARTER_MONTHLY=price_xxx     # €19/month
STRIPE_PRICE_GROWTH_SETUP=price_xxx        # €49 one-time
STRIPE_PRICE_GROWTH_MONTHLY=price_xxx      # €39/month
STRIPE_PRICE_PRO_SETUP=price_xxx           # €149 one-time
STRIPE_PRICE_PRO_MONTHLY=price_xxx         # €79/month
STRIPE_PRICE_LIFETIME_LEGACY=price_xxx     # €690 one-time (manual only, never promoted)

# ----- Legal docs versioning ----------------------------------------
# Bump these when ToS/Privacy/DPA changes; tenants will be prompted to re-accept
LEGAL_TERMS_VERSION=2026-05-01
LEGAL_PRIVACY_VERSION=2026-05-01
LEGAL_DPA_VERSION=2026-05-01

# ----- Satispay (one-time link payments) ----------------------------
SATISPAY_KEY_ID=
SATISPAY_PRIVATE_KEY=
SATISPAY_ENV=production

# ----- Billing jurisdiction -----------------------------------------
# Mirrors organizations.billing_jurisdiction in DB. Possible values:
#   'br_pj'       — Brazilian PJ via Stripe Brasil + Wise EUR (v1 default)
#   'it_partner'  — Italian partner P.IVA via Stripe Italy
#   'it_srl'      — Edson's SRL once registered (full SDI invoicing)
DEFAULT_BILLING_JURISDICTION=br_pj

# ----- Wise Business (EUR balance to avoid FX loss) -----------------
WISE_API_KEY=
WISE_PROFILE_ID=
WISE_EUR_ACCOUNT_IBAN=

# ----- Resend (transactional email, EU region) ----------------------
RESEND_API_KEY=
RESEND_FROM=ciao@thefactory.life

# ----- Plausible (analytics) ----------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=thefactory.life

# ----- Operator config ----------------------------------------------
# Comma-separated list of email addresses authorised as operators
# (Edson + future field reps). Anyone in this list can access /app/factory/*.
OPERATOR_EMAILS=edson@thefactory.life

# ----- GDPR ---------------------------------------------------------
# Salt for hashing visitor IPs in consent records. Random, long, secret.
CONSENT_HASH_SALT=

# ----- Misc ---------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://app.thefactory.life
